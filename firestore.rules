rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helper functions
    // ============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isAdmin() {
      return isAuthenticated()
        && getUserData(request.auth.uid).roles.hasAny(['admin']);
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData(request.auth.uid).roles.hasAny([role]);
    }

    function roleStatusIs(role, status) {
      return isAuthenticated()
        && getUserData(request.auth.uid).roleStatus[role] == status;
    }

    function isRole(role) {
      return hasRole(role) || roleStatusIs(role, 'approved');
    }

    // ============================================================
    // users/{uid}
    // - User can read/write their own document
    // - Admin can read/write any user document
    // ============================================================
    match /users/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ============================================================
    // Role subcollections (users/{uid}/vendorProfile, riderProfile, etc.)
    // - Owner can read/write their own subcollection
    // - Admin can read/write any
    // ============================================================
    match /users/{uid}/{roleProfile}/{document=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // ============================================================
    // stalls/{stallId}
    // - Anyone can read a stall (public listing)
    // - Vendor can create if they have the vendor role
    // - Vendor can update their own stall
    // - Admin can do everything
    // ============================================================
    match /stalls/{stallId} {

      allow read: if true;

      allow create: if isAuthenticated()
                  && isRole('vendor')
                  && request.resource.data.vendorId == request.auth.uid
                  && request.resource.data.keys().hasAll(['id', 'name', 'vendorId'])
                  && request.resource.data.name is string
                  && request.resource.data.name.size() > 0;

      allow update: if isAuthenticated()
                  && (
                    (resource.data.vendorId == request.auth.uid && isRole('vendor'))
                    || isAdmin()
                  )
                  && request.resource.data.name is string
                  && request.resource.data.name.size() > 0;

      allow delete: if isAdmin();
    }

    // ============================================================
    // orders/{orderId}
    // - Customer, vendor, rider, and admin can read relevant orders
    // - Customer creates orders
    // - Vendor updates order fulfillment
    // - Rider updates delivery status
    // - Customer can cancel their own order
    // - Admin can do everything
    // ============================================================
    match /orders/{orderId} {

      allow read: if isAuthenticated()
                  && (
                    resource.data.userId == request.auth.uid
                    || resource.data.vendorId == request.auth.uid
                    || resource.data.riderId == request.auth.uid
                    || (roleStatusIs('rider', 'approved') && resource.data.status == 'ready')
                    || isAdmin()
                  );

      allow create: if isAuthenticated()
                  && request.resource.data.userId == request.auth.uid
                  && request.resource.data.keys().hasAll(['userId', 'items', 'total', 'status', 'stallId']);

      allow update: if isAuthenticated()
                  && (
                    (resource.data.vendorId == request.auth.uid && isRole('vendor'))
                    || (resource.data.riderId == request.auth.uid && isRole('rider'))
                    || (resource.data.status == 'ready' && resource.data.riderId == null
                        && roleStatusIs('rider', 'approved')
                        && request.resource.data.riderId == request.auth.uid
                        && request.resource.data.status == 'delivering')
                    || (resource.data.userId == request.auth.uid
                        && request.resource.data.status == 'cancelled'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledReason']))
                    || isAdmin()
                  );

      allow delete: if isAdmin();
    }

    // ============================================================
    // reviews/{reviewId}
    // ============================================================
    match /reviews/{reviewId} {

      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                  && request.resource.data.userId == request.auth.uid
                  && request.resource.data.keys().hasAll(['userId', 'stallId', 'rating', 'comment']);

      allow update: if false;

      allow delete: if isAdmin();
    }

    // ============================================================
    // riderReviews/{reviewId}
    // ============================================================
    match /riderReviews/{reviewId} {

      allow read: if isAuthenticated()
                && (
                  request.auth.uid == resource.data.riderId
                  || isAdmin()
                );

      allow create: if isAuthenticated()
                  && request.resource.data.userId == request.auth.uid
                  && request.resource.data.keys().hasAll(['userId', 'riderId', 'rating', 'comment']);

      allow update: if false;

      allow delete: if isAdmin();
    }

    // ============================================================
    // applications/{docId}
    // - User can create their own application with pending status
    // - Any authenticated user can read (for status checks)
    // - Admin can update status (approve/reject)
    // - No deletes by non-admin
    // ============================================================
    match /applications/{docId} {

      allow create: if isAuthenticated()
                  && request.resource.data.userId == request.auth.uid
                  && request.resource.data.keys().hasAll(['userId', 'role', 'status'])
                  && request.resource.data.role in ['vendor', 'rider']
                  && request.resource.data.status == 'pending';

      allow read: if isAuthenticated();

      allow update: if isAdmin()
                  && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'rejectionReason']);

      allow delete: if false;
    }

    // ============================================================
    // Deny all other collections and operations by default
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
